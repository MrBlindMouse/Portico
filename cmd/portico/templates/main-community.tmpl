package main

import (
	"flag"
	"log"
	"os"

	portico "github.com/MrBlindMouse/Portico"
	"github.com/MrBlindMouse/Portico/scaffold"
)

func main() {
	addr := flag.String("addr", ":2222", "SSH listen address")
	flag.Parse()

	exp, err := portico.New().
		Merge(scaffold.RecipeCommunity()).
		Build()
	if err != nil {
		log.Fatal(err)
	}
	dataDir := ".portico-data"
	if v := os.Getenv("PORTICO_DATA"); v != "" {
		dataDir = v
	}
	opts := portico.Options{
		DataDir:     dataDir,
		InspectAddr: "127.0.0.1:9922",
		StatusAddr:  "127.0.0.1:9923",
	}
	if v := os.Getenv("PORTICO_LOG_LEVEL"); v != "" {
		opts.LogLevel = v
	}
	if err := portico.Serve(*addr, exp, opts); err != nil {
		log.Fatal(err)
	}
}
